# Flask Secret Key for Session Security
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# Database Configuration (SQLite by default)
DATABASE_URL=sqlite:///instance/restaurant.db

# Flask Environment: development / production / testing
FLASK_ENV=development

# Initial Administrator Credentials (used when seeding or initializing)
ADMIN_EMAIL=admin@forksandknife.com
ADMIN_PASSWORD=AdminPassword123!

# Optional Flask-Mail configuration (if email confirmations are enabled)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
